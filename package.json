{
  "name": "locus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "pipeline"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w client",
    "preview": "npm run preview -w client",
    "test": "npm run test -w shared",
    "typecheck": "tsc -p client/tsconfig.json && tsc -p pipeline/tsconfig.json",
    "data": "npm run index -w pipeline -- --sync",
    "deploy": "npm run build -w client && npx wrangler pages deploy"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
