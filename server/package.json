    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@locus/shared": "*",
    "@neondatabase/serverless": "^1.0.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.0",
    "express": "^5.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.2"
  }
}
