# Server-side key: Geocoding, Places (New), Routes. IP-restricted.
GOOGLE_MAPS_SERVER_KEY=
# Browser key: Maps JavaScript API only. Referrer-restricted. Exposed to the client by Vite.
GOOGLE_MAPS_BROWSER_KEY=
# Optional cloud map style ID (Google Cloud Console -> Map Management). Exposed to the client.
GOOGLE_MAPS_MAP_ID=
# SQLite file, relative to the repo root. Created and migrated on first run.
DATABASE_FILE=data/locus.db
PORT=3001
